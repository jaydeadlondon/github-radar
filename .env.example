# GitHub personal access token: GitHub -> Settings -> Developer settings ->
# Personal access tokens -> Generate new token (scope: public_repo is enough)
RADAR_GITHUB_TOKEN=
RADAR_GITHUB_RATE_LIMIT_WARNING_REMAINING=100

# Runtime mode. Keep development locally; production requires API auth settings.
RADAR_ENVIRONMENT=development
# Leave empty locally; production requires both keys and auth enabled.
RADAR_DATABASE_URL=sqlite+aiosqlite:///./radar.db
RADAR_API_AUTH_ENABLED=false
# RADAR_API_KEY=read-only-key
# RADAR_ADMIN_API_KEY=admin-key
# RADAR_CORS_ORIGINS=["http://localhost:8000"]
# Maximum accepted request body size in bytes (default 256 KiB).
RADAR_MAX_REQUEST_BYTES=262144

RADAR_ANALYTICS_ROLLING_WINDOW=14
RADAR_ANALYTICS_BURST_Z=2.5
RADAR_ANALYTICS_BURST_MIN_DELTA=5
RADAR_ANALYTICS_BURST_MIN_DAYS=2
RADAR_ANALYTICS_HISTORY_DAYS=180

RADAR_SCHEDULER_ENABLED=false
RADAR_SCHEDULER_INTERVAL_HOURS=24
# A successful snapshot older than this is stale; empty uses 2 scheduler intervals.
RADAR_TRACKING_STALE_AFTER_HOURS=
# Limit backfill pagination when needed; empty means all available pages.
RADAR_BACKFILL_MAX_PAGES=

RADAR_ALERTS_ENABLED=true
RADAR_ALERT_WEBHOOK_URL=
RADAR_ALERT_WEBHOOK_TIMEOUT_SECONDS=10
RADAR_WEBHOOK_MAX_ATTEMPTS=5
RADAR_WEBHOOK_BACKOFF_BASE_SECONDS=1
RADAR_WEBHOOK_DISABLE_AFTER_FAILURES=5
# RADAR_WEBHOOK_SIGNING_SECRET=change-me
RADAR_WEBHOOK_PROVIDER=generic
# Off by default: webhook targets that resolve to private or loopback addresses
# are refused (SSRF protection). Set to true only when the webhook deliberately
# lives on your local network, e.g. a self-hosted ntfy/Apprise bridge. Cloud
# metadata addresses (169.254.0.0/16, ::1, 0.0.0.0) stay blocked either way.
RADAR_WEBHOOK_ALLOW_PRIVATE_ADDRESSES=false
# Structured logs: text for local, json for log collectors.
RADAR_LOG_LEVEL=INFO
RADAR_LOG_FORMAT=text

RADAR_WORKER_LOCK_TTL_SECONDS=900
RADAR_WORKER_RETRY_ATTEMPTS=3
RADAR_WORKER_RETRY_BACKOFF_SECONDS=5
RADAR_METRICS_ENABLED=true